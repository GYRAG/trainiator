# Copy to .env for local dev; set these as real env vars in production.
# The real .env is gitignored — never commit it.

# HTTP/WS port the server listens on.
PORT=3000

# SQLite file path. In Docker, mount a persistent volume at data/ to keep wallets.
DB_PATH=data/trainiator.sqlite

# REQUIRED before exposing publicly — gates /admin and /admin/stats.
# Generate one:  node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me

# Leave blank for same-origin (prod + Vite dev proxy). Only set to your frontend
# origin if you deploy the frontend on a separate host.
CLIENT_ORIGIN=

NODE_ENV=production
